# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env / secrets — never commit credentials
.env
.env.*
*.local
!.env.example

# Logs
*.log
npm-debug.log*

# Playwright / browser automation artifacts
.playwright-cli/
test-results/

# Temporary render/capture output
tmp/
*.tmp
.renders/
captures/

# Caches
.cache/
.parcel-cache/
.vite/

# OS junk
.DS_Store
Thumbs.db
nul

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace

# Blender auto-backups (.blend source stays tracked — see NOTE below)
*.blend[0-9]*

# Gauntlet harness captured output (scripts stay tracked, dumps don't)
__gauntlet/*.txt
__gauntlet/*-profile.json

# NOTE: intentionally NOT ignored — these are project source of truth:
#   docs/gauntlet/          (gauntlet state, registries, specs)
#   .agents/skills/         (Devin skills)
#   .devin/                 (Devin project config)
#   assets/blender/**/*.blend   (editable 3D source)
#   assets/media/prompts/   (prompt provenance)
__gauntlet/.chrome-profile/
